# Hyperliquid live-trading (НЕ коммитьте .env с реальными ключами!)
# Docker: положите этот файл как .env рядом с docker-compose.yml — compose подхватит через env_file.
# Приватный ключ API wallet (Settings → API на hyperliquid.xyz)
HYPERLIQUID_PRIVATE_KEY=
# Адрес ОСНОВНОГО аккаунта с депозитом (верхний правый угол в приложении), НЕ адрес API wallet
HYPERLIQUID_WALLET_ADDRESS=

# Telegram уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=